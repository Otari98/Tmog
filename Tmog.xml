							</OnLeave>
						</Scripts>
					</Button>
				</Frames>
				<Scripts>
					<OnLoad>
						this:SetAutoFocus(false)
						this:SetTextInsets(15, 8, 0, 0)
					</OnLoad>
					<OnEnterPressed>
						Tmog.Search()
						this:ClearFocus()
					</OnEnterPressed>
					<OnEscapePressed>
						this:SetText("")
						this:ClearFocus()
					</OnEscapePressed>
					<OnTextChanged>
						Tmog.Search()
					</OnTextChanged>
				</Scripts>
