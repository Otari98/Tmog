						</Backdrop>
						<Scripts>
							<OnClick>
								local box = this:GetParent()
								if box:GetText() == "" then
									return
								end
								box:SetText("")
								box:ClearFocus()
								PlaySound("igMainMenuOption")
							</OnClick>
							<OnEnter>
								TmogTooltip:SetOwner(this, "ANCHOR_TOPRIGHT", 0, 0)
								TmogTooltip:SetText("Clear")
