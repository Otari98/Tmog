		<Scripts>
			<OnLoad>
				Tmog.OnLoad(this)
			</OnLoad>
			<OnEvent>
				Tmog.OnEvent(this, event, arg1, arg2, arg3, arg4)
			</OnEvent>
			<OnShow>
				Tmog.OnShow(this)
			</OnShow>
			<OnHide>
				Tmog.OnHide(this)
			</OnHide>
			<OnMouseDown>
				DropDownList1:Hide()
				TmogFrameSearchBox:ClearFocus()
			</OnMouseDown>
			<OnDragStart>
				this:StartMoving()
			</OnDragStart>
			<OnDragStop>
				this:StopMovingOrSizing()
			</OnDragStop>
			<OnMouseWheel>
				if arg1 > 0 then
					if TmogFrameNextPage:IsEnabled() == 1 then Tmog.GoToPage(Tmog.currentPage + 1) end
				else
					if TmogFramePrevPage:IsEnabled() == 1 then Tmog.GoToPage(Tmog.currentPage - 1) end
				end
			</OnMouseWheel>
			<OnUpdate>
				Tmog.OnUpdate(this, arg1)
			</OnUpdate>
		</Scripts>
