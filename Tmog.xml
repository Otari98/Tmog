					</Layer>
				</Layers>
				<HighlightTexture alphaMode="ADD" file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight"/>
				<Scripts>
					<OnLoad>
						this:RegisterForDrag("LeftButton")
						SetPortraitToTexture(TmogButtonPortrait, "interface\\icons\\inv_chest_cloth_41")
					</OnLoad>
					<OnDragStart>
						this:LockHighlight()
						if this:IsMovable() then
							this:StartMoving()
						end
					</OnDragStart>
					<OnDragStop>
						this:UnlockHighlight()
						if this:IsMovable() then
							this:StopMovingOrSizing()
						end
						local x, y = this:GetCenter()
						TmogConfig.buttonX = x
						TmogConfig.buttonY = y
					</OnDragStop>
					<OnEnter>
						TmogTooltip:SetOwner(this, "ANCHOR_TOPLEFT", 0, 0)
						TmogTooltip:AddLine("Tmog " .. Tmog.version, 1, 1, 1)
						TmogTooltip:AddLine(Tmog.L["Left-click to toggle dressing room\nHold Left-click and drag to move this button"])
						TmogTooltip:Show()
					</OnEnter>
					<OnLeave>
						TmogTooltip:Hide()
					</OnLeave>
					<OnMouseUp>
						Tmog.ToggleFrame()
					</OnMouseUp>
				</Scripts>
